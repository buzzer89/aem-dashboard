{
  "projectType": "nextjs-react-test-web-app",
  "preferredLanguage": "typescript",
  "preferredPackageManager": "npm",
  "preferredStyling": "tailwind",
  "testing": {
    "unit": true,
    "integration": true,
    "frameworks": ["jest", "react-testing-library"]
